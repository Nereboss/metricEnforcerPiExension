{
  "logLevel": "warning",
  "analyzers": {
    "ccsh": {
      "enabled": true,
      "command": "ccsh",
      "args": [
        "unifiedparser",
        ".",
        "--base-file=.pi/metricEnforcer/cachedAnalysis.cc.json",
        "--output-file=.pi/metricEnforcer/cachedAnalysis.cc.json",
        "--not-compressed"
      ]
    }
  },
  "backpressure": {
    "errorOnly": false,
    "maxBackpressureRetries": 5
  },
  "thresholds": {
    "global": {
      "complexity": {
        "warning": 50,
        "error": 100
      },
      "logic_complexity": {
        "warning": 40,
        "error": 80
      },
      "max_complexity_per_function": {
        "warning": 25,
        "error": 35
      },
      "rloc": {
        "warning": 250,
        "error": 500
      },
      "comment_lines": {
        "warning": 50,
        "error": 100
      }
    },
    "filePatterns": {
    }
  }
}
