{
  "analyzers": {
    "ccsh": {
      "enabled": true,
      "command": "ccsh",
      "args": [
        "unifiedparser",
        ".",
        "--base-file=.pi/metricEnforcer/cachedAnalysis.cc.json",
        "--output-file=.pi/metricEnforcer/cachedAnalysis.cc.json",
        "--not-compressed"
      ]
    }
  },
  "thresholds": {
    "global": {
      "complexity": {
        "warning": 10,
        "error": 15
      },
      "rloc": {
        "warning": 15,
        "error": 25
      }
    },
    "filePatterns": {
      "*.ts": {
        "complexity": {
          "warning": 8,
          "error": 12
        },
        "rloc": {
          "warning": 2,
          "error": 16
        }
      }
    }
  }
}
