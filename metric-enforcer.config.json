{
  "analyzers": {
    "ccsh": {
      "enabled": true,
      "command": "ccsh",
      "args": ["unifiedparser", "."]
    }
  },
  "thresholds": {
    "global": {
      "complexity": {
        "warning": 10,
        "error": 15
      },
      "rloc": {
        "warning": 15,
        "error": 25
      }
    },
    "filePatterns": {
      "*.ts": {
        "complexity": {
          "warning": 8,
          "error": 12
        },
        "rloc": {
          "warning": 12,
          "error": 16
        }
      }
    }
  }
}
